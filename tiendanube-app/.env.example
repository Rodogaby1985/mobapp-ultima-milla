# Variables de entorno para MOBAPP FLASH - Tienda Nube App
# Copiá este archivo a .env y completá los valores

# Puerto y host del servidor
PORT=3000
HOST=0.0.0.0

# Modalidad de la app (no cambiar)
MODALIDAD=flash

# URL pública de la app (usada para el OAuth callback y el callback de cotización)
# En Dokku: se configura automáticamente como DOKKU_APP_SSL_URL
PUBLIC_API_URL=https://flash.mobappexpress.com

# Secreto para las sesiones (cambiar en producción por un valor aleatorio largo)
SESSION_SECRET=change-me-in-production

# URL de Redis
REDIS_URL=redis://localhost:6379

# Credenciales de Tienda Nube (OAuth)
APP_ID=tu_app_id_tienda_nube
CLIENT_SECRET=tu_client_secret_tienda_nube

# Google Sheet
GOOGLE_SHEET_ID=1rlMBJAjV6FwhesW8y2SUX43ogQeqLw8QKIbbDEirTfg

# Credenciales de Google Cloud (Service Account)
# Opción 1: JSON completo como string (recomendado para producción/Dokku)
# GCP_CREDENTIALS_JSON={"type":"service_account",...}

# Opción 2: Ruta al archivo credentials.json (para desarrollo local)
# GCP_CREDENTIALS_PATH=./credentials.json
